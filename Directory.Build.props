<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup Label="Versioning">
        <!--bump to the next version after each release-->
        <Version>2.4.0</Version>
        <!--CI overrides VersionSuffix (e.g. -rc.<build>) for dev feeds and sets ApplyVersionSuffix=false for release-->
        <VersionSuffix Condition=" '$(VersionSuffix)' == '' ">-local.1</VersionSuffix>
        <ApplyVersionSuffix Condition=" '$(ApplyVersionSuffix)' == '' ">true</ApplyVersionSuffix>
        <PackageVersion>$(Version)</PackageVersion>
        <PackageVersion Condition=" '$(ApplyVersionSuffix)' == 'true' ">$(PackageVersion)$(VersionSuffix)</PackageVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Configurations>Debug;Release</Configurations>

        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
        <Features>strict</Features>

        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <WarningLevel>9999</WarningLevel>
        <ErrorReport>prompt</ErrorReport>
        <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

        <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
        <RunAnalyzersDuringLiveAnalysis>true</RunAnalyzersDuringLiveAnalysis>
        <AnalysisLevel>preview-All</AnalysisLevel>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!--set true temporarily to profile per-analyzer build cost-->
        <ReportAnalyzer>false</ReportAnalyzer>

        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <ArtifactsPath>$(MSBuildThisFileDirectory).build</ArtifactsPath>
        <ArtifactsPivots>$(Configuration)</ArtifactsPivots>
    </PropertyGroup>

    <ItemGroup Label="External Code Analyzers">
        <PackageReference Include="Lindhart.Analyser.MissingAwaitWarning">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>analyzers</IncludeAssets>
        </PackageReference>

        <PackageReference Include="AsyncFixer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>analyzers</IncludeAssets>
        </PackageReference>

        <PackageReference Include="Meziantou.Analyzer">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>analyzers</IncludeAssets>
        </PackageReference>

        <!--Microsoft.CodeAnalysis.Analyzers removed: bundled with the SDK-->
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>build; analyzers</IncludeAssets>
        </PackageReference>

    </ItemGroup>
</Project>
