<Project>
    <ItemGroup>
        <!--main-->
        <PackageVersion Include="Seq.Apps" Version="2023.4.0" />
        <PackageVersion Include="AdaptiveCards.Templating" Version="2.0.6" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
        <!--dependency pinning as Seq host loads the plugin in-process with System.Text.Json v8;
            stay on the v8 line (latest patch) to avoid an assembly-load conflict with the host-->
        <PackageVersion Include="System.Text.Json" Version="8.0.6" />

        <!--build-->
        <PackageVersion Include="Meziantou.Polyfill" Version="1.0.150" />
        <!--PolySharp is a transitive dependency of AdaptiveCards.Templating; pinned for determinism.
            Its source generator is stripped in the csproj (RemovePolySharpAnalyzers) in favour of Meziantou.Polyfill-->
        <PackageVersion Include="PolySharp" Version="1.14.1" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
        <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.2" />

        <!--analyzers-->
        <PackageVersion Include="Lindhart.Analyser.MissingAwaitWarning" Version="3.2.0" />
        <PackageVersion Include="AsyncFixer" Version="2.1.0" />
        <PackageVersion Include="Meziantou.Analyzer" Version="3.0.102" />
        <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.301" />

        <!--tests-->
        <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.2.3" />
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
        <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageVersion Include="NUnit" Version="4.6.1" />
        <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    </ItemGroup>
</Project>
